# Copy to .env and adjust. Never commit .env.
# All values here are development defaults — NOT for production.

APP_ENV=development

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=carebridge
POSTGRES_PASSWORD=carebridge_dev_password
POSTGRES_DB=carebridge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://carebridge:carebridge_dev_password@localhost:5432/carebridge

# Auth — generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=120

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Object storage: local | (future) s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=10485760

# ---------- AI ----------
# DEMO_MODE=true pins the deterministic local provider: no external call is
# possible, no credentials are needed, and the demo cannot fail on an outage.
DEMO_MODE=true

# Used only when DEMO_MODE=false. mock | openai | anthropic | gemini
AI_PROVIDER=mock
# Leave empty to use each provider's default model.
AI_MODEL=

AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=60
AI_CACHE_ENABLED=true

# Server-side only. Never expose these to any frontend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional cost estimate override (USD per million tokens) for unlisted models.
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# ---------- Documents (Phase 3) ----------
# How pages without a text layer (scans, photos) are read:
#   auto     = the provider's vision input when DEMO_MODE=false and it has one, otherwise local OCR
#   local    = offline OCR only — no page image ever leaves the server
#   provider = the configured AI provider's vision input (sends page images to that provider)
#   none     = text layers only
# DEMO_MODE=true always reads locally.
OCR_ENGINE=auto
OCR_MIN_TEXT_LAYER_CHARS=20
DOCUMENT_PROCESSING_MAX_PAGES=10
DOCUMENT_RENDER_SCALE=2.0
DOCUMENT_MAX_PIXELS=40000000

# Frontends (read by Next.js at build/dev time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
