{
  "about": "Deterministic evaluation paths for the history conversation engine. Every expectation here is written by hand from the flow definition, not generated by the engine, so a disagreement means the engine or the definition is wrong. Synthetic answers only. The flows are ENGINEERING DRAFTS awaiting clinical review; these paths check that the engine walks them honestly, not that they are clinically right.",
  "defaults": "An answer not given in a path is the least committal honest one: free text 'in my own words', a structured duration of 3 days, and 'not sure' (v1: 'unsure') on any choice. Defaults therefore keep every branch shut.",
  "paths": [
    {
      "id": "A-linear",
      "matrix": "A",
      "flow_version": 2,
      "description": "Nothing opens a branch: only the core questions are asked, and every follow-up is recorded as not asked, with its reason.",
      "answers": {},
      "expect": {
        "asked": [
          "current_problem.primary",
          "symptom.onset.when",
          "symptom.location",
          "symptom.character",
          "symptom.radiation",
          "symptom.associated",
          "symptom.aggravating",
          "symptom.relieving",
          "history.relevant",
          "medications.current",
          "allergies.known"
        ],
        "not_applicable": {
          "symptom.duration": "onset_not_known",
          "symptom.location.other": "location_other_not_chosen",
          "symptom.character.other": "character_other_not_chosen",
          "symptom.radiation.location": "radiation_not_reported",
          "symptom.associated.other": "associated_other_not_chosen",
          "symptom.aggravating.other": "aggravating_other_not_chosen",
          "symptom.relieving.other": "relieving_other_not_chosen",
          "history.relevant.details": "history_not_reported",
          "medications.details": "medications_not_reported",
          "allergies.details": "allergies_not_reported"
        },
        "candidates": [
          "current_problem.primary"
        ]
      }
    },
    {
